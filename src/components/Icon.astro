---
/**
 * Icon-Set als Inline-SVG.
 *
 * Bewusst keine Icon-Bibliothek: Die wenigen benötigten Symbole werden direkt
 * eingebettet. Das spart eine zusätzliche Anfrage und hält die Strichstärke
 * über alle Icons hinweg einheitlich (1.7).
 *
 * Icons sind standardmässig dekorativ (aria-hidden). Wird `title` gesetzt,
 * erhält das SVG eine zugängliche Bezeichnung.
 */
interface Props {
  name: string;
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 24, title, class: className } = Astro.props;

/** Pfaddaten der Icons – alle auf einem 24×24-Raster gezeichnet. */
const PATHS: Record<string, string> = {
  // Leistungen
  layout: '<path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5z"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  shield: '<path d="M12 3l7.5 3v5.6c0 4.4-3 8.3-7.5 9.4-4.5-1.1-7.5-5-7.5-9.4V6z"/><path d="M9.2 12.1l2 2 3.6-3.9"/>',
  mail: '<path d="M3.5 6.5h17v11h-17z"/><path d="M3.9 7.2l8.1 5.6 8.1-5.6"/>',
  cloud: '<path d="M7.2 18.5a4 4 0 0 1-.4-8A5.4 5.4 0 0 1 17.3 9.6a3.7 3.7 0 0 1 .3 7.4z"/><path d="M12 12v5.6"/><path d="M9.8 14.1L12 11.9l2.2 2.2"/>',
  spark: '<path d="M12 3l1.9 5.3 5.3 1.9-5.3 1.9L12 17.4l-1.9-5.3L4.8 10l5.3-1.9z"/><path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>',
  // Vorteile
  user: '<path d="M12 12.2a3.8 3.8 0 1 0 0-7.6 3.8 3.8 0 0 0 0 7.6z"/><path d="M4.8 20c.6-3.6 3.6-5.9 7.2-5.9s6.6 2.3 7.2 5.9"/>',
  chat: '<path d="M20.5 12.3c0 3.9-3.8 7-8.5 7-1 0-2-.1-2.9-.4L4 20.5l1.4-3.8a6.6 6.6 0 0 1-1.9-4.4c0-3.9 3.8-7 8.5-7s8.5 3.1 8.5 7z"/><path d="M8.8 12.3h6.4"/><path d="M8.8 9.4h4.3"/>',
  stack: '<path d="M12 3.5l8.5 4.3-8.5 4.3-8.5-4.3z"/><path d="M3.5 12l8.5 4.3 8.5-4.3"/><path d="M3.5 16.2l8.5 4.3 8.5-4.3"/>',
  target: '<path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17z"/><path d="M12 16.2a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4z"/><path d="M12 13.4a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8z"/>',
  receipt: '<path d="M5.5 3.5h13v17l-2.2-1.5-2.2 1.5-2.1-1.5-2.2 1.5-2.2-1.5-2.1 1.5z"/><path d="M9 8.5h6"/><path d="M9 12.5h6"/>',
  lifebuoy: '<path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17z"/><path d="M12 15.4a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8z"/><path d="M6 6l3.6 3.6"/><path d="M14.4 14.4L18 18"/><path d="M18 6l-3.6 3.6"/><path d="M9.6 14.4L6 18"/>',
  // Navigation und Aktionen
  'arrow-right': '<path d="M4.5 12h15"/><path d="M13.6 6l5.9 6-5.9 6"/>',
  'arrow-up-right': '<path d="M7 17L17 7"/><path d="M8.4 7H17v8.6"/>',
  phone: '<path d="M8.4 4.2l2 .3 1 3.4-1.8 1.4a10.4 10.4 0 0 0 5.1 5.1l1.4-1.8 3.4 1 .3 2c0 1.4-1.2 2.6-2.6 2.6A14.6 14.6 0 0 1 5.8 6.8c0-1.4 1.2-2.6 2.6-2.6z"/>',
  at: '<path d="M15.5 12a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z"/><path d="M15.5 8.5V13a2.6 2.6 0 0 0 5.1-.7A8.6 8.6 0 1 0 16 19.8"/>',
  check: '<path d="M5 12.8l4.4 4.4L19 7.6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  // Sonstiges
  clock: '<path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17z"/><path d="M12 7.2V12l3.2 1.9"/>',
  compass: '<path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17z"/><path d="M15.2 8.8l-1.8 4.6-4.6 1.8 1.8-4.6z"/>',
  code: '<path d="M8.6 8.2L4.5 12l4.1 3.8"/><path d="M15.4 8.2l4.1 3.8-4.1 3.8"/><path d="M13.4 5.5l-2.8 13"/>',
  document: '<path d="M6 3.5h7.5L18.5 8v12.5h-12.5z"/><path d="M13.2 3.6V8.3h4.8"/><path d="M9 13h6"/><path d="M9 16.4h4.3"/>',
  rocket: '<path d="M12 3.5c3 2 4.6 5.1 4.6 8.6l-1.9 4.3h-5.4L7.4 12c0-3.5 1.6-6.6 4.6-8.5z"/><path d="M12 11.3a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2z"/><path d="M9.3 16.4l-1.4 4 3-1.6 1.1 2 1.1-2 3 1.6-1.4-4"/>',
  handshake: '<path d="M3.5 9.4l3.3-3.3 3.6.9 2.2 2.2-1.6 1.6-2-1.2"/><path d="M20.5 9.4l-3.3-3.3-3.6.9"/><path d="M13.4 10.8l3.3 3.3"/><path d="M11.2 13l3.3 3.3"/><path d="M9 15.2l3.3 3.3"/><path d="M6.8 6.1v7.3l4 4.6h4.4l5.3-5.3V6.1"/>',
};

const path = PATHS[name] ?? PATHS.check;
const hasTitle = Boolean(title);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={hasTitle ? 'img' : undefined}
  aria-hidden={hasTitle ? undefined : 'true'}
  focusable="false"
>
  {hasTitle && <title>{title}</title>}
  <Fragment set:html={path} />
</svg>
