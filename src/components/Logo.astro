---
/**
 * Logo von Saugy Solutions.
 *
 * Die Bildmarke stammt aus der zentralen Konfiguration
 * (`content/settings/site.yml` → `branding.logo`) und ist an keiner Stelle
 * fest eingebaut. Header, Hero und Footer verwenden ausschliesslich diese
 * Komponente.
 *
 * Proportionen: Breite und Höhe stammen aus `src/data/logo-manifest.json`,
 * das die Logo-Pipeline beim Build aus der echten Datei ermittelt. Dadurch
 * wird das Logo nie verzerrt, nie beschnitten und es entsteht kein
 * Layoutsprung beim Laden.
 *
 * Der Schriftzug steht als Text daneben – so bleibt der Name für
 * Suchmaschinen und Screenreader lesbar, ohne die Bildmarke zu verändern.
 */
import { BRAND } from '../data/site.mjs';
import logo from '../data/logo-manifest.json';

interface Props {
  /** Gewünschte Höhe der Bildmarke in Pixeln. Die Breite folgt daraus. */
  size?: number;
  /** Nur die Bildmarke, ohne Schriftzug. */
  markOnly?: boolean;
  /** Bild sofort laden – für Kopfzeile und Hero. */
  eager?: boolean;
  /** Grösse des Schriftzugs in rem. */
  wordmarkSize?: number;
  class?: string;
}

const {
  size = 40,
  markOnly = false,
  eager = true,
  wordmarkSize = 1.12,
  class: className,
} = Astro.props;

// Breite aus dem echten Seitenverhältnis – niemals geraten.
const ratio = logo.width / logo.height;
const width = Math.round(size * ratio);

/**
 * Sinnvolle Anzeigebreiten für das `sizes`-Attribut. Das Logo wird nie
 * grösser als seine Datei dargestellt.
 */
const sizesAttr = `${width}px`;
---

<span class:list={['logo', className]}>
  {
    logo.isVector ? (
      /* Vektorlogo: eine Datei für alle Grössen. */
      <img
        class="logo__mark"
        src={logo.src}
        width={width}
        height={size}
        alt={markOnly ? BRAND.logoAlt : ''}
        aria-hidden={markOnly ? undefined : 'true'}
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
        style={`width:${width}px;height:${size}px`}
      />
    ) : (
      <picture>
        {logo.webp && <source srcset={logo.webp} sizes={sizesAttr} type="image/webp" />}
        <img
          class="logo__mark"
          src={logo.src}
          srcset={logo.srcset ?? undefined}
          sizes={sizesAttr}
          width={width}
          height={size}
          alt={markOnly ? BRAND.logoAlt : ''}
          aria-hidden={markOnly ? undefined : 'true'}
          decoding="async"
          loading={eager ? 'eager' : 'lazy'}
          style={`width:${width}px;height:${size}px`}
        />
      </picture>
    )
  }

  {
    !markOnly && (
      <span class="logo__text" style={`font-size:${wordmarkSize}rem`}>
        <span class="logo__name">{BRAND.wordmarkStrong}</span>
        {BRAND.wordmarkRest ? ` ${BRAND.wordmarkRest}` : ''}
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--c-text);
  }

  /*
    `object-fit: contain` ist die Rückversicherung: Selbst wenn Breite und
    Höhe einmal nicht zum Bild passen sollten, wird das Logo eingepasst statt
    verzerrt. Kein Zuschnitt, kein runder Rahmen, kein farbiger Schein.
  */
  .logo__mark {
    display: block;
    object-fit: contain;
    border-radius: 0;
    background: none;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));
    transition: filter var(--t-base) var(--ease-out);
  }

  a:hover .logo__mark,
  a:focus-visible .logo__mark {
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.75));
  }

  .logo__text {
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--c-text);
  }

  .logo__name {
    font-weight: 800;
  }

  @media (max-width: 22rem) {
    .logo {
      gap: 0.5rem;
    }

    .logo__text {
      font-size: 1rem !important;
    }
  }
</style>
