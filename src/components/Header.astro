---
/**
 * Globale Kopfleiste (Navigations-Header).
 *
 * Abzugrenzen vom Hero-Bereich der Startseite: Der Hero ist zentriert, die
 * Kopfleiste bleibt eine funktionale Leiste mit Logo links und Aktionen
 * rechts. Beide verwenden dasselbe Logo aus der zentralen Konfiguration.
 *
 * Verhalten:
 *   - dauerhaft sichtbar beim Scrollen (position: sticky)
 *   - auf Mobilgeräten immer mit abgesetztem Hintergrund, damit der
 *     Menübutton jederzeit erkennbar bleibt
 *   - Aussparungen moderner Geräte (iPhone) werden berücksichtigt
 *   - auf Mobilgeräten öffnet ein Drawer mit Fokusfalle und Scroll-Sperre
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, NAV_CTA, CONTACT } from '../data/site.mjs';

interface Props {
  heroPage?: boolean;
}

const { heroPage = false } = Astro.props;

/** Aktueller Pfad, normalisiert auf abschliessenden Schrägstrich. */
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

/** Markiert auch Unterseiten (z. B. /projekte/swisshub/ unter „Projekte“). */
function isActive(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href);
}
---

<header class:list={['site-header', { 'site-header--hero': heroPage }]} data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${NAV[0]?.label ?? 'Startseite'} – Saugy Solutions`}>
      <Logo size={38} />
    </a>

    <!-- Waagrechte Navigation ab Desktopbreite -->
    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={CONTACT.phoneHref} class="site-header__phone">
        <Icon name="phone" size={17} />
        <span>{CONTACT.phone}</span>
      </a>

      <a href={NAV_CTA.href} class="btn btn--primary site-header__cta">
        {NAV_CTA.label}
        <Icon name="arrow-right" size={17} class="btn__icon" />
      </a>

      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="haupt-menue"
        aria-label="Menü öffnen"
      >
        <span class="nav-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!--
  Mobiles Menü als Drawer. Liegt ausserhalb des <header>, damit es den
  gesamten Bildschirm einnehmen kann, ohne vom Sticky-Kontext beschnitten zu
  werden.
-->
<div class="nav-drawer" id="haupt-menue" data-nav-panel hidden>
  <div class="nav-drawer__backdrop" data-nav-backdrop></div>

  <div class="nav-drawer__panel" role="dialog" aria-modal="true" aria-label="Menü">
    <div class="nav-drawer__head">
      <Logo size={34} />
      <button type="button" class="nav-drawer__close" data-nav-close>
        <Icon name="close" size={20} />
        <span>Schliessen</span>
      </button>
    </div>

    <nav class="nav-drawer__body" aria-label="Menü">
      <ul class="nav-drawer__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-drawer__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-drawer__foot">
      <a href={NAV_CTA.href} class="btn btn--primary btn--block btn--lg">{NAV_CTA.label}</a>

      <div class="nav-drawer__contact">
        <a href={CONTACT.phoneHref}>
          <Icon name="phone" size={17} />
          {CONTACT.phone}
        </a>
        <a href={CONTACT.emailHref}>
          <Icon name="at" size={17} />
          {CONTACT.email}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ====================================================== Kopfleiste */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* Aussparungen (iPhone-Notch, abgerundete Ecken) freihalten. */
    padding-top: var(--safe-top);
    border-bottom: 1px solid var(--c-line);
    /*
      Auf Mobilgeräten dauerhaft abgesetzt, damit der Menübutton über jedem
      Inhalt lesbar bleibt. Auf Desktop erst beim Scrollen (siehe unten).
    */
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: background-color var(--t-base) var(--ease-out),
      border-color var(--t-base) var(--ease-out);
  }

  /* Browser ohne backdrop-filter erhalten eine deckende Fläche. */
  @supports not (backdrop-filter: blur(4px)) {
    .site-header {
      background: var(--c-bg);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    /* Seitliche Aussparungen im Querformat berücksichtigen. */
    padding-inline: calc(var(--gutter) + var(--safe-left)) calc(var(--gutter) + var(--safe-right));
    padding-block: 0.7rem;
    transition: padding-block var(--t-base) var(--ease-out);
  }

  .site-header.is-scrolled .site-header__inner {
    padding-block: 0.5rem;
  }

  .site-header__brand {
    flex: none;
    text-decoration: none;
    /* Grosszügiges Touch-Ziel, ohne das Layout zu verändern. */
    padding-block: 0.25rem;
  }

  /* ====================================================== Desktop-Navigation */
  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--r-full);
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out), background-color var(--t-fast) var(--ease-out);
  }

  .site-nav__link:hover {
    color: var(--c-text);
    background: rgba(255, 255, 255, 0.05);
  }

  .site-nav__link.is-active {
    color: var(--c-text);
  }

  /* Aktive Seite zusätzlich über eine Linie – nicht nur farblich. */
  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: var(--r-full);
    background: linear-gradient(to right, var(--c-accent), var(--c-accent-2));
  }

  /* ====================================================== Aktionen */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex: none;
  }

  .site-header__phone,
  .site-header__cta {
    display: none;
  }

  .site-header__phone {
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__phone:hover {
    color: var(--c-accent);
  }

  /* ====================================================== Menübutton */
  .nav-toggle {
    display: grid;
    place-items: center;
    /* Mindestens 44 × 44 px – komfortables Touch-Ziel. */
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.04);
    color: var(--c-text);
    transition: border-color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .nav-toggle:hover {
    border-color: var(--c-accent-line);
    color: var(--c-accent);
  }

  .nav-toggle__icon {
    display: grid;
    gap: 5px;
    width: 19px;
  }

  .nav-toggle__icon span {
    display: block;
    height: 2px;
    width: 100%;
    border-radius: var(--r-full);
    background: currentColor;
    transition: transform var(--t-base) var(--ease-out), opacity var(--t-fast) var(--ease-out);
  }

  /* Symbol wird beim Öffnen zum Kreuz. */
  :global(.is-nav-open) .nav-toggle__icon span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  :global(.is-nav-open) .nav-toggle__icon span:nth-child(2) {
    opacity: 0;
  }
  :global(.is-nav-open) .nav-toggle__icon span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ====================================================== Drawer */
  .nav-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
  }

  .nav-drawer[hidden] {
    display: none;
  }

  .nav-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out);
  }

  .nav-drawer__panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(23rem, 100%);
    padding: calc(var(--safe-top) + 0.9rem) calc(var(--gutter) + var(--safe-right))
      calc(var(--safe-bottom) + var(--sp-6)) var(--gutter);
    background: var(--c-bg-alt);
    border-left: 1px solid var(--c-line);
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform var(--t-base) var(--ease-out);
  }

  :global(.is-nav-open) .nav-drawer__backdrop {
    opacity: 1;
  }

  :global(.is-nav-open) .nav-drawer__panel {
    transform: translateX(0);
  }

  .nav-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--c-line);
  }

  .nav-drawer__close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.04);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-text-muted);
  }

  .nav-drawer__close:hover {
    border-color: var(--c-accent-line);
    color: var(--c-text);
  }

  .nav-drawer__body {
    padding-block: var(--sp-4);
  }

  .nav-drawer__list {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    /* Mindesthöhe für ein bequemes Touch-Ziel. */
    min-height: 3rem;
    padding: 0.7rem 0.25rem;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
  }

  .nav-drawer__link :global(svg) {
    color: var(--c-text-muted);
    transition: transform var(--t-base) var(--ease-out), color var(--t-base) var(--ease-out);
  }

  .nav-drawer__link:hover :global(svg),
  .nav-drawer__link:focus-visible :global(svg) {
    transform: translateX(4px);
    color: var(--c-accent);
  }

  .nav-drawer__link.is-active {
    color: var(--c-accent);
  }

  .nav-drawer__foot {
    display: grid;
    gap: var(--sp-5);
    margin-top: auto;
    padding-top: var(--sp-6);
  }

  .nav-drawer__contact {
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
  }

  .nav-drawer__contact a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    color: var(--c-text-muted);
    text-decoration: none;
  }

  .nav-drawer__contact a:hover {
    color: var(--c-accent);
  }

  /* ====================================================== Ab Tablet */
  @media (min-width: 46rem) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  /* ====================================================== Ab Desktop */
  @media (min-width: 62rem) {
    .site-header {
      /* Auf Desktop erst beim Scrollen absetzen – der Hero wirkt offener. */
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom-color: transparent;
    }

    .site-header.is-scrolled {
      background: color-mix(in srgb, var(--c-bg) 84%, transparent);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      border-bottom-color: var(--c-line);
    }

    @supports not (backdrop-filter: blur(4px)) {
      .site-header.is-scrolled {
        background: var(--c-bg);
      }
    }

    .site-nav {
      display: block;
    }

    .nav-toggle,
    .nav-drawer {
      display: none;
    }
  }

  @media (min-width: 72rem) {
    .site-nav__list {
      gap: 0.35rem;
    }

    .site-nav__link {
      padding: 0.5rem 0.85rem;
    }

    .site-nav__link.is-active::after {
      left: 0.85rem;
      right: 0.85rem;
    }
  }

  @media (min-width: 84rem) {
    .site-header__phone {
      display: inline-flex;
    }

    .site-header__inner {
      gap: var(--sp-6);
    }
  }

  /* Im Querformat auf flachen Geräten kompakter. */
  @media (max-height: 26rem) and (orientation: landscape) {
    .site-header__inner {
      padding-block: 0.4rem;
    }

    .nav-drawer__link {
      min-height: 2.5rem;
      font-size: var(--fs-base);
    }
  }
</style>
