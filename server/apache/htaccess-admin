# ============================================================================
#  ADMINBEREICH
#  Wird beim Deployment-Build als /admin/.htaccess abgelegt.
# ============================================================================

Options -Indexes

<IfModule mod_headers.c>
    # Der Adminbereich gehört nicht in Suchmaschinen.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"

    # Anmeldestand nie zwischenspeichern.
    Header always set Cache-Control "no-store, no-cache, must-revalidate"

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"

    # --- Content Security Policy des Adminbereichs --------------------------
    # Bewusst eigene Regeln, weil Decap CMS mit GitHub sprechen muss:
    #
    #   connect-src  Zugriff auf die GitHub-Schnittstelle (Inhalte lesen und
    #                schreiben) sowie den Token-Austausch
    #   img-src      Profilbilder und Medien aus dem Repository
    #   script-src   'wasm-unsafe-eval' wird für die mitgelieferten
    #                WebAssembly-Module benötigt
    #
    # Die öffentliche Website behält ihre deutlich strengere Vorgabe aus der
    # .htaccess im Wurzelverzeichnis.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://github.com; img-src 'self' data: blob: https://avatars.githubusercontent.com https://raw.githubusercontent.com https://*.githubusercontent.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com; worker-src 'self' blob:; upgrade-insecure-requests"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# Die CMS-Bibliothek ändert sich nur bei einem neuen Build.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|wasm)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
