---
/**
 * Häufige Fragen.
 *
 * Verwendet <details>/<summary>: funktioniert vollständig ohne JavaScript,
 * ist von Haus aus per Tastatur bedienbar und für Screenreader verständlich.
 */
interface Props {
  items: { q: string; a: string }[];
  /** Erste Frage geöffnet darstellen. */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((item, index) => (
      <details class="faq__item" open={openFirst && index === 0} data-reveal>
        <summary class="faq__question">
          <span>{item.q}</span>
          <span class="faq__marker" aria-hidden="true" />
        </summary>
        <div class="faq__answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--sp-3);
    max-width: var(--measure);
  }

  .faq__item {
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface);
    transition: border-color var(--t-base) var(--ease-out);
  }

  .faq__item:hover,
  .faq__item[open] {
    border-color: var(--c-line-strong);
  }

  .faq__question {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    font-size: var(--fs-base);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--c-text);
    cursor: pointer;
    list-style: none;
  }

  /* Standard-Dreieck ausblenden – wir setzen ein eigenes Zeichen. */
  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: -3px;
    border-radius: var(--r-md);
  }

  /* Pluszeichen, das sich beim Öffnen zu einem Minus dreht. */
  .faq__marker {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.22rem;
    color: var(--c-accent);
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: var(--r-full);
    background: currentColor;
    transform: translateY(-50%);
    transition: transform var(--t-base) var(--ease-out), opacity var(--t-fast) var(--ease-out);
  }

  .faq__marker::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq__item[open] .faq__marker::after {
    transform: translateY(-50%) rotate(0deg);
    opacity: 0;
  }

  .faq__answer {
    padding: 0 var(--sp-5) var(--sp-5);
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
  }

  .faq__answer p {
    max-width: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__answer {
      animation: faq-open var(--t-base) var(--ease-out);
    }
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
