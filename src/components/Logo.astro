---
/**
 * Logo von Saugy Solutions.
 *
 * Verwendet die bestehende Bildmarke unverändert (freigestellt und für das Web
 * optimiert, siehe scripts/generate-logo-assets.mjs). Daneben steht der
 * Schriftzug als Text – dadurch bleibt der Name für Suchmaschinen und
 * Screenreader lesbar, ohne die Bildmarke zu verändern.
 */
import { SITE } from '../data/site.mjs';

interface Props {
  /** Höhe der Bildmarke in Pixeln. */
  size?: number;
  /** Schriftzug ausblenden (z. B. auf sehr schmalen Flächen). */
  markOnly?: boolean;
  class?: string;
}

const { size = 44, markOnly = false, class: className } = Astro.props;

// Die Bildmarke ist nahezu quadratisch (535 × 533 px im Original).
const width = Math.round(size * (535 / 533));
---

<span class:list={['logo', className]}>
  <picture class="logo__mark">
    <source srcset="/img/logo-saugy-solutions-320.webp" type="image/webp" />
    <img
      src="/img/logo-saugy-solutions-320.png"
      width={width}
      height={size}
      alt={markOnly ? `${SITE.name} – Startseite` : ''}
      aria-hidden={markOnly ? undefined : 'true'}
      decoding="async"
      loading="eager"
      style={`width:${width}px;height:${size}px`}
    />
  </picture>
  {
    !markOnly && (
      <span class="logo__text">
        <span class="logo__name">Saugy</span> Solutions
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--c-text);
  }

  .logo__mark img {
    /* Hebt die Bildmarke leicht vom dunklen Untergrund ab. */
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.55));
    transition: filter var(--t-base) var(--ease-out);
  }

  a:hover .logo__mark img,
  a:focus-visible .logo__mark img {
    filter: drop-shadow(0 4px 18px rgba(36, 230, 178, 0.35));
  }

  .logo__text {
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--c-text);
  }

  .logo__name {
    font-weight: 800;
  }

  @media (max-width: 22rem) {
    .logo__text {
      font-size: 1rem;
    }
  }
</style>
