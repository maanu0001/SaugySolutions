---
/**
 * Startseite.
 *
 * Inhalte und Reihenfolge stammen aus `content/settings/home.yml` und werden
 * im Adminbereich bearbeitet. Jeder Abschnitt lässt sich dort ein- und
 * ausblenden sowie umsortieren – die Gestaltung bleibt dabei fest, damit das
 * Erscheinungsbild nicht auseinanderfällt.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/HeroHome.astro';
import SectionHead from '../components/SectionHead.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TeamCard from '../components/TeamCard.astro';
import Faq from '../components/Faq.astro';
import CtaSection from '../components/CtaSection.astro';

import { homeData, pagesData, renderAccent, plainText } from '../data/content.mjs';
import { SERVICES } from '../data/services.mjs';
import { FEATURED_PROJECTS } from '../data/projects.mjs';
import { PROCESS } from '../data/process.mjs';
import { BENEFITS } from '../data/benefits.mjs';
import { TEAM } from '../data/team.mjs';
import { FAQ_HOME } from '../data/faq.mjs';

const hero = homeData.hero ?? {};
const sections = homeData.sections ?? {};
const ctaConfig = homeData.cta ?? {};
const meta = pagesData.home ?? {};

/** Sichtbare Abschnitte in der im Adminbereich gewählten Reihenfolge. */
const order = Object.entries(sections)
  .filter(([, config]) => config?.visible !== false)
  .sort((a, b) => (a[1]?.order ?? 99) - (b[1]?.order ?? 99))
  .map(([key, config]) => ({ key, ...config }));

const show = (key) => order.find((s) => s.key === key);

/** Wechselt den Abschnittshintergrund, damit die Seite Rhythmus bekommt. */
const bg = (key) => (order.findIndex((s) => s.key === key) % 2 === 1 ? 'section--alt' : '');

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQ_HOME.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={meta.title ?? 'Saugy Solutions'}
  description={meta.description ?? ''}
  path="/"
  schema={[faqSchema]}
  heroPage
>
  <HeroHome hero={hero} project={FEATURED_PROJECTS[0] ?? null} />

  {order.map((section) => {
    /* ================================================== VORTEILE ============ */
    if (section.key === 'benefits') {
      return (
        <section class:list={['section', bg('benefits')]} aria-labelledby="vorteile-titel">
          <div class="container">
            <SectionHead
              eyebrow={section.eyebrow}
              title={renderAccent(section.title)}
              lead={section.lead}
              id="vorteile-titel"
            />
            <div class="bento bento--benefits">
              {BENEFITS.map((benefit, i) => (
                <article
                  class:list={['tile', i === 0 && 'tile--wide']}
                  data-reveal
                  data-reveal-delay={(i % 4) + 1}
                >
                  <span class="icon-badge">
                    <Icon name={benefit.icon} size={22} />
                  </span>
                  <h3 class="tile__title">{benefit.title}</h3>
                  <p class="tile__text">{benefit.text}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    }

    /* ================================================== LEISTUNGEN ========== */
    if (section.key === 'services') {
      const [lead, ...rest] = SERVICES;
      return (
        <section class:list={['section', bg('services')]} aria-labelledby="leistungen-titel">
          <div class="container">
            <div class="split-head">
              <SectionHead
                eyebrow={section.eyebrow}
                title={renderAccent(section.title)}
                lead={section.lead}
                id="leistungen-titel"
                class="split-head__text"
              />
              {section.cta_label && (
                <Button href="/leistungen/" variant="secondary" class="split-head__action">
                  {section.cta_label}
                </Button>
              )}
            </div>

            <div class="bento bento--services">
              {/* Hauptleistung als grosse Kachel */}
              {lead && (
                <article class="tile tile--feature" data-reveal>
                  <span class="icon-badge">
                    <Icon name={lead.icon} size={24} />
                  </span>
                  <h3 class="tile__title tile__title--lg">
                    <a href={`/leistungen/#${lead.slug}`} class="tile__link">{lead.title}</a>
                  </h3>
                  <p class="tile__text">{lead.teaser}</p>
                  <ul class="tile__list">
                    {lead.includes.slice(0, 4).map((item) => (
                      <li>{item.title}</li>
                    ))}
                  </ul>
                  <span class="tile__more">
                    <span>Mehr dazu</span>
                    <Icon name="arrow-right" size={16} />
                  </span>
                </article>
              )}

              {rest.map((service, i) => (
                <article class="tile" data-reveal data-reveal-delay={(i % 4) + 1}>
                  <span class="icon-badge">
                    <Icon name={service.icon} size={22} />
                  </span>
                  <h3 class="tile__title">
                    <a href={`/leistungen/#${service.slug}`} class="tile__link">{service.title}</a>
                  </h3>
                  <p class="tile__text">{service.teaser}</p>
                  <span class="tile__more">
                    <span>Mehr dazu</span>
                    <Icon name="arrow-right" size={16} />
                  </span>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    }

    /* ================================================== PROJEKTE ============ */
    if (section.key === 'projects' && FEATURED_PROJECTS.length > 0) {
      return (
        <section class:list={['section', bg('projects')]} aria-labelledby="projekte-titel">
          <div class="container">
            <div class="split-head">
              <SectionHead
                eyebrow={section.eyebrow}
                title={renderAccent(section.title)}
                lead={section.lead}
                id="projekte-titel"
                class="split-head__text"
              />
              {section.cta_label && (
                <Button href="/projekte/" variant="secondary" class="split-head__action">
                  {section.cta_label}
                </Button>
              )}
            </div>

            <div class="grid grid--3">
              {FEATURED_PROJECTS.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </div>
        </section>
      );
    }

    /* ================================================== ABLAUF ============== */
    if (section.key === 'process') {
      return (
        <section class:list={['section', bg('process')]} aria-labelledby="ablauf-titel">
          <div class="container">
            <div class="process-layout">
              <div class="process-layout__intro">
                <SectionHead
                  eyebrow={section.eyebrow}
                  title={renderAccent(section.title)}
                  lead={section.lead}
                  id="ablauf-titel"
                />
                {section.cta_label && (
                  <Button href="/ablauf/" variant="secondary">{section.cta_label}</Button>
                )}
              </div>

              <div class="process-layout__steps">
                <ProcessSteps steps={PROCESS.slice(0, section.steps_shown ?? 5)} />
                <p class="process-layout__more">
                  Danach folgen Veröffentlichung und – auf Wunsch – die laufende Betreuung.
                  <a href="/ablauf/">Alle Schritte ansehen</a>
                </p>
              </div>
            </div>
          </div>
        </section>
      );
    }

    /* ================================================== TEAM ================ */
    if (section.key === 'team') {
      return (
        <section class:list={['section', bg('team')]} aria-labelledby="team-titel">
          <div class="container">
            <SectionHead
              eyebrow={section.eyebrow}
              title={renderAccent(section.title)}
              lead={section.lead}
              id="team-titel"
              center
            />
            <div class="grid grid--2 team-grid">
              {TEAM.map((person, i) => (
                <TeamCard person={person} delay={i + 1} />
              ))}
            </div>
            {section.cta_label && (
              <p class="team-note" data-reveal>
                <a href="/ueber-uns/">{section.cta_label}</a>
              </p>
            )}
          </div>
        </section>
      );
    }

    /* ================================================== QUALITÄT ============ */
    if (section.key === 'trust') {
      return (
        <section class:list={['section', bg('trust')]} aria-labelledby="qualitaet-titel">
          <div class="container">
            <div class="trust">
              <div class="trust__text">
                <SectionHead
                  eyebrow={section.eyebrow}
                  title={renderAccent(section.title)}
                  lead={section.lead}
                  id="qualitaet-titel"
                />
                <ul class="check-list trust__list">
                  {(section.points ?? []).map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>

              <aside class="trust__aside" data-reveal>
                <h3 class="trust__aside-title">{section.aside_title}</h3>
                <ul class="trust__aside-list">
                  {(section.aside_points ?? []).map((point) => (
                    <li>
                      <strong>{point.strong}</strong> {point.text}
                    </li>
                  ))}
                </ul>
              </aside>
            </div>
          </div>
        </section>
      );
    }

    /* ================================================== FAQ ================= */
    if (section.key === 'faq' && FAQ_HOME.length > 0) {
      return (
        <section class:list={['section', 'section--tight', bg('faq')]} aria-labelledby="faq-titel">
          <div class="container">
            <div class="faq-layout">
              <SectionHead
                eyebrow={section.eyebrow}
                title={renderAccent(section.title)}
                lead={section.lead}
                id="faq-titel"
              />
              <div>
                <Faq items={FAQ_HOME} openFirst />
                {section.cta_label && (
                  <p class="faq-layout__more">
                    <a href="/leistungen/#fragen">{section.cta_label}</a>
                  </p>
                )}
              </div>
            </div>
          </div>
        </section>
      );
    }

    return null;
  })}

  {
    ctaConfig.visible !== false && (
      <CtaSection title={plainText(ctaConfig.title)} text={ctaConfig.text} />
    )
  }
</BaseLayout>

<style>
  /* ============================================================ Bento-Raster */
  .bento {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: 1fr;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    transition: border-color var(--t-base) var(--ease-out),
      transform var(--t-base) var(--ease-out), background-color var(--t-base) var(--ease-out);
  }

  /* Feine Akzentlinie, die beim Hover von links einläuft. */
  .tile::after {
    content: '';
    position: absolute;
    left: var(--sp-6);
    right: var(--sp-6);
    bottom: 0;
    height: 2px;
    border-radius: var(--r-full);
    background: linear-gradient(to right, var(--c-accent), var(--c-accent-2));
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    transition: transform var(--t-slow) var(--ease-out), opacity var(--t-base) var(--ease-out);
  }

  .tile:hover,
  .tile:focus-within {
    border-color: var(--c-line-strong);
    background: var(--c-surface-raised);
    transform: translateY(calc(-3px * var(--motion-scale)));
  }

  .tile:hover::after,
  .tile:focus-within::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .tile__title {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-lg);
  }

  .tile__title--lg {
    font-size: var(--fs-xl);
  }

  .tile__link {
    text-decoration: none;
  }

  /* Ganze Kachel klickbar, ohne den Linktext unklar zu machen. */
  .tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tile__text {
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
  }

  .tile__list {
    display: grid;
    gap: 0.45rem;
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .tile__list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--fs-xs);
    color: var(--c-text-muted);
  }

  .tile__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--c-accent);
    opacity: 0.7;
  }

  .tile__more {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--sp-5);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-accent);
  }

  .tile__more :global(svg) {
    transition: transform var(--t-base) var(--ease-out);
  }

  .tile:hover .tile__more :global(svg) {
    transform: translateX(4px);
  }

  /* --- Ab Tablet: echtes Bento-Raster --- */
  @media (min-width: 44rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .bento--benefits {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Erster Vorteil bekommt mehr Gewicht. */
    .bento--benefits .tile--wide {
      grid-column: span 2;
    }

    .bento--services {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Hauptleistung nimmt zwei Spalten und zwei Reihen ein. */
    .bento--services .tile--feature {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* ==================================================== Abschnitt mit Aktion */
  .split-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-5);
    margin-bottom: var(--sp-8);
  }

  .split-head :global(.split-head__text) {
    margin-bottom: 0;
    flex: 1 1 26rem;
  }

  .split-head :global(.split-head__action) {
    flex: none;
  }

  /* ================================================================= Ablauf */
  .process-layout {
    display: grid;
    gap: var(--sp-8);
  }

  .process-layout__more {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  .process-layout__more a {
    color: var(--c-accent);
    margin-left: 0.35rem;
  }

  @media (min-width: 62rem) {
    .process-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--sp-9);
      align-items: start;
    }

    .process-layout__intro {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }

  /* =================================================================== Team */
  .team-grid {
    max-width: 62rem;
    margin-inline: auto;
  }

  .team-note {
    margin: var(--sp-6) auto 0;
    text-align: center;
    font-size: var(--fs-sm);
  }

  .team-note a {
    color: var(--c-accent);
  }

  /* =============================================================== Qualität */
  .trust {
    display: grid;
    gap: var(--sp-7);
  }

  .trust__list {
    margin-top: var(--sp-6);
  }

  .trust__aside {
    align-self: start;
    padding: var(--sp-6);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .trust__aside-title {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-lg);
  }

  .trust__aside-list {
    display: grid;
    gap: var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  .trust__aside-list li {
    padding-left: var(--sp-5);
    border-left: 2px solid var(--c-accent);
  }

  @media (min-width: 62rem) {
    .trust {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--sp-8);
      align-items: start;
    }
  }

  /* ==================================================================== FAQ */
  .faq-layout {
    display: grid;
    gap: var(--sp-6);
  }

  .faq-layout :global(.section-head) {
    margin-bottom: 0;
  }

  .faq-layout__more {
    margin-top: var(--sp-5);
    font-size: var(--fs-sm);
  }

  .faq-layout__more a {
    color: var(--c-accent);
  }

  @media (min-width: 62rem) {
    .faq-layout {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--sp-8);
      align-items: start;
    }

    .faq-layout :global(.section-head) {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }
</style>
