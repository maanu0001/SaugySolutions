---
/**
 * Impressum / Anbieterinformationen.
 *
 * Alle Angaben stammen aus src/data/site.mjs. Noch nicht bestätigte Angaben
 * werden sichtbar als offen markiert und dürfen so nicht live gehen.
 *
 * HINWEIS: Dieser Text ist eine Vorlage. Er sollte vor der Veröffentlichung
 * fachlich geprüft werden (siehe README).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegalValue from '../components/LegalValue.astro';
import { LEGAL, CONTACT, SITE, addressLines } from '../data/site.mjs';

const title = 'Impressum | Saugy Solutions';
const description = 'Anbieterinformationen und Kontaktangaben von Saugy Solutions.';
---

<BaseLayout title={title} description={description} path="/impressum/">
  <section class="legal">
    <div class="container container--narrow">
      <Breadcrumbs items={[{ label: 'Impressum' }]} />

      <h1 class="legal__title">Impressum</h1>
      <p class="legal__meta">Anbieterinformationen gemäss schweizerischem Recht.</p>

      <div class="prose">
        <h2>Anbieter</h2>
        <dl>
          <div>
            <dt>Firma</dt>
            <dd>{LEGAL.provider}</dd>
          </div>
          <div>
            <dt>Rechtsform</dt>
            <dd><LegalValue value={LEGAL.legalForm} /></dd>
          </div>
          <div>
            <dt>Verantwortliche Person</dt>
            <dd>{LEGAL.responsible}</dd>
          </div>
          <div>
            <dt>Adresse</dt>
            <dd>
              {addressLines().map((line) => (
                <span class="legal__line">{line}</span>
              ))}
            </dd>
          </div>
          {
            /*
              UID nur ausgeben, wenn tatsächlich eine vorhanden ist. Eine nicht
              existierende Nummer muss nicht angegeben werden.
            */
            LEGAL.uid && (
              <div>
                <dt>UID / MWST-Nummer</dt>
                <dd>
                  <LegalValue value={LEGAL.uid} />
                </dd>
              </div>
            )
          }
        </dl>

        {
          !LEGAL.uid && (
            <p>
              Saugy Solutions wird als nebenberufliche selbstständige Tätigkeit geführt und ist
              nicht im Handelsregister eingetragen. Eine UID beziehungsweise MWST-Nummer besteht
              daher nicht.
            </p>
          )
        }

        <h2>Kontakt</h2>
        <dl>
          <div>
            <dt>Telefon</dt>
            <dd><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></dd>
          </div>
          <div>
            <dt>E-Mail</dt>
            <dd><a href={CONTACT.emailHref}>{CONTACT.email}</a></dd>
          </div>
          <div>
            <dt>Website</dt>
            <dd><a href={`${SITE.url}/`}>{SITE.url.replace('https://', '')}</a></dd>
          </div>
        </dl>

        <h2>Verantwortlich für den Inhalt</h2>
        <p>
          {LEGAL.responsible}, {LEGAL.provider}. Für Fragen, Hinweise oder Korrekturen zu Inhalten
          dieser Website wenden Sie sich bitte an <a href={CONTACT.emailHref}>{CONTACT.email}</a>.
        </p>

        <h2>Haftung für Inhalte</h2>
        <p>
          Die Inhalte dieser Website werden mit Sorgfalt erstellt. Für die Richtigkeit,
          Vollständigkeit und Aktualität der Inhalte kann keine Gewähr übernommen werden. Die Nutzung
          der Inhalte erfolgt auf eigene Verantwortung.
        </p>

        <h2>Haftung für Links</h2>
        <p>
          Diese Website enthält Verweise auf Websites Dritter – insbesondere auf die im
          Projektbereich genannten Auftritte. Auf deren Inhalte haben wir keinen Einfluss. Für die
          Inhalte verlinkter Seiten ist ausschliesslich deren jeweiliger Anbieter verantwortlich.
        </p>

        <h2>Urheberrecht</h2>
        <p>
          Texte, Bilder, Gestaltung und Quellcode dieser Website sind urheberrechtlich geschützt. Die
          Bildmarke von Saugy Solutions darf ohne Zustimmung nicht verwendet werden. Die im
          Projektbereich genannten Marken- und Firmennamen gehören den jeweiligen Inhabern und werden
          ausschliesslich zur Beschreibung der eigenen Referenzen genannt.
        </p>

        <h2>Hosting</h2>
        <p>
          Diese Website wird betrieben bei: <LegalValue value={LEGAL.hostingProvider} />.
          Serverstandort: <LegalValue value={LEGAL.hostingLocation} />. Angaben zur Verarbeitung von
          Server-Logdaten finden Sie in der <a href="/datenschutz/">Datenschutzerklärung</a>.
        </p>

        <h2>Streitbeilegung</h2>
        <p>
          Wir sind nicht verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen. Anliegen klären wir gerne direkt – melden Sie
          sich einfach bei uns.
        </p>

        <p class="legal__updated">Stand: {LEGAL.lastUpdated}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(2rem, 1rem + 4vw, 3.5rem) var(--section-y);
  }

  .legal__title {
    font-size: var(--fs-3xl);
  }

  .legal__meta {
    margin: var(--sp-3) 0 var(--sp-7);
    color: var(--c-text-muted);
  }

  /* Adresszeilen untereinander statt in einer Zeile. */
  .legal__line {
    display: block;
  }

  .legal__updated {
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-xs);
  }
</style>
