---
/**
 * Visuelle Begleitung des Hero-Bereichs.
 *
 * Bewusst keine erfundenen Dashboards oder bedeutungslosen Diagramme: gezeigt
 * werden ein stilisiertes Browserfenster mit einer schematischen Seitenstruktur
 * sowie die Bildmarke von Saugy Solutions. Die Beschriftungen benennen echte
 * Leistungen.
 *
 * Die gesamte Darstellung ist dekorativ (aria-hidden) – alle Informationen
 * stehen im Text daneben.
 */
---

<div class="hero-visual" aria-hidden="true">
  <span class="hero-visual__glow"></span>

  <!-- Stilisiertes Browserfenster -->
  <div class="hero-visual__window">
    <div class="hero-visual__chrome">
      <span class="hero-visual__dot"></span>
      <span class="hero-visual__dot"></span>
      <span class="hero-visual__dot"></span>
      <span class="hero-visual__address">saugy-solutions.ch</span>
    </div>

    <div class="hero-visual__page">
      <div class="hero-visual__row">
        <span class="hero-visual__block hero-visual__block--mark"></span>
        <span class="hero-visual__block hero-visual__block--nav"></span>
        <span class="hero-visual__block hero-visual__block--nav"></span>
        <span class="hero-visual__block hero-visual__block--btn"></span>
      </div>

      <div class="hero-visual__hero">
        <span class="hero-visual__line hero-visual__line--1"></span>
        <span class="hero-visual__line hero-visual__line--2"></span>
        <span class="hero-visual__line hero-visual__line--3"></span>
        <span class="hero-visual__cta"></span>
      </div>

      <div class="hero-visual__cards">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>

  <!-- Bildmarke, leicht überlappend -->
  <picture class="hero-visual__mark">
    <source srcset="/img/logo-saugy-solutions-320.webp" type="image/webp" />
    <img
      src="/img/logo-saugy-solutions-320.png"
      width="118"
      height="118"
      alt=""
      decoding="async"
      loading="eager"
    />
  </picture>

  <!-- Beschriftungen mit echten Leistungen -->
  <span class="hero-visual__chip hero-visual__chip--1">Hosting</span>
  <span class="hero-visual__chip hero-visual__chip--2">E-Mail</span>
</div>

<style>
  .hero-visual {
    position: relative;
    isolation: isolate;
    padding: 1.5rem 0 2.5rem;
  }

  .hero-visual__glow {
    position: absolute;
    top: -18%;
    right: -14%;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--c-accent) 0%, transparent 66%);
    opacity: 0.2;
    filter: blur(60px);
    z-index: -1;
  }

  /* --- Fenster ------------------------------------------------------------ */
  .hero-visual__window {
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    background: linear-gradient(162deg, var(--c-surface-raised), var(--c-bg-alt));
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .hero-visual__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.95rem;
    border-bottom: 1px solid var(--c-line);
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-visual__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-line-strong);
  }

  .hero-visual__dot:first-child {
    background: rgba(36, 230, 178, 0.6);
  }

  .hero-visual__address {
    margin-left: 0.7rem;
    padding: 0.18rem 0.8rem;
    border-radius: var(--r-full);
    background: rgba(0, 0, 0, 0.32);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--c-text-muted);
  }

  .hero-visual__page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.4rem 1.5rem 1.8rem;
  }

  .hero-visual__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-visual__block {
    display: block;
    border-radius: var(--r-full);
    background: var(--c-line-strong);
  }

  .hero-visual__block--mark {
    width: 2.6rem;
    height: 0.62rem;
    border-radius: var(--r-sm);
    background: linear-gradient(to right, var(--c-accent), var(--c-accent-2));
  }

  .hero-visual__block--nav {
    width: 2rem;
    height: 0.34rem;
  }

  .hero-visual__block--btn {
    margin-left: auto;
    width: 3.4rem;
    height: 0.78rem;
    background: rgba(36, 230, 178, 0.35);
  }

  .hero-visual__hero {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hero-visual__line {
    height: 0.52rem;
    border-radius: var(--r-full);
    background: var(--c-line-strong);
  }

  .hero-visual__line--1 {
    width: 78%;
    height: 1rem;
    background: color-mix(in srgb, var(--c-text) 42%, transparent);
  }

  .hero-visual__line--2 {
    width: 56%;
    height: 1rem;
    background: color-mix(in srgb, var(--c-text) 22%, transparent);
  }

  .hero-visual__line--3 {
    width: 44%;
  }

  .hero-visual__cta {
    width: 5.4rem;
    height: 1.25rem;
    margin-top: 0.5rem;
    border-radius: var(--r-full);
    background: linear-gradient(120deg, var(--c-accent), var(--c-accent-2));
    opacity: 0.85;
  }

  .hero-visual__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .hero-visual__cards span {
    height: 3.6rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.03);
  }

  .hero-visual__cards span:first-child {
    border-color: rgba(36, 230, 178, 0.28);
    background: var(--c-accent-soft);
  }

  /* --- Bildmarke ----------------------------------------------------------- */
  .hero-visual__mark {
    position: absolute;
    left: -1.9rem;
    bottom: -1.6rem;
    display: block;
    filter: drop-shadow(0 16px 34px rgba(0, 0, 0, 0.75));
  }

  .hero-visual__mark img {
    width: clamp(74px, 16vw, 118px);
    height: auto;
  }

  /* --- Beschriftungen ------------------------------------------------------ */
  .hero-visual__chip {
    position: absolute;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-full);
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--c-text-muted);
    box-shadow: var(--shadow-md);
  }

  .hero-visual__chip--1 {
    top: 2.6rem;
    right: -0.4rem;
    border-color: rgba(36, 230, 178, 0.35);
    color: var(--c-accent);
  }

  .hero-visual__chip--2 {
    bottom: 3.6rem;
    right: 1.2rem;
    border-color: rgba(40, 199, 215, 0.32);
    color: var(--c-accent-2);
  }

  /* Sehr zurückhaltendes Schweben – nur wenn Bewegung erwünscht ist. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-visual__mark {
      animation: hero-float 7s var(--ease-in-out) infinite alternate;
    }

    .hero-visual__chip--1 {
      animation: hero-float 9s var(--ease-in-out) infinite alternate-reverse;
    }

    .hero-visual__chip--2 {
      animation: hero-float 11s var(--ease-in-out) infinite alternate;
    }
  }

  @keyframes hero-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-9px);
    }
  }

  @media (max-width: 30rem) {
    .hero-visual__chip--2 {
      display: none;
    }
  }
</style>
